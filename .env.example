NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HOTNOW_DB_SCHEMA=hotnow
NEXT_PUBLIC_HOTNOW_DB_SCHEMA=hotnow
PARALLEL_API_KEY=
BLITZ_API_KEY=
LLM_PROVIDER=parallel
APP_URL=http://localhost:3000
# Docker Compose settings (not API credentials).
HOTNOW_PORT=3001
DOCKER_APP_URL=http://localhost:3001
# Optional: use gemini or anthropic for signal generation instead of parallel.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Signing secret from Parallel Settings > Webhooks (not the API key).
# Requires a public HTTPS APP_URL; localhost uses the background worker.
PARALLEL_WEBHOOK_SECRET=

# Lead delivery. See DELIVERY.md for the provider consoles and exact redirect URLs.
# Encrypts Slack, Google, and Teams credentials at rest. Use a long random value:
# openssl rand -base64 32
DELIVERY_TOKEN_KEY=
# Slack app bot scopes: chat:write, chat:write.public, channels:read, groups:read, channels:join
# Redirect: {APP_URL}/api/delivery/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Google Cloud OAuth client for Sheets. Separate from Supabase Google sign-in.
# Enable the Google Sheets API. Scope: https://www.googleapis.com/auth/spreadsheets
# Redirect: {APP_URL}/api/delivery/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Telegram bot from @BotFather. Public HTTPS also needs TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
HOTNOW_DB_SCHEMA=hotnow
NEXT_PUBLIC_HOTNOW_DB_SCHEMA=hotnow
# Company discovery (FindAll) and official-domain search.
PARALLEL_API_KEY=
# Clay personal API key (Clay → Settings → Account). Required for seller research and buying situations.
CLAY_API_KEY=
# HotNow — Seller Intelligence v1. Public routine id; used when this is unset.
CLAY_ROUTINE_ID=workflow:wf_0tmxbl8enV2ZTXSfktn
BLITZ_API_KEY=
# Prospeo people search + verified email/mobile (https://prospeo.io/api-docs). Sent as the X-KEY header.
# Optional. If unset, contact jobs continue with Blitz only. Set it on Vercel and on the Render worker.
PROSPEO_API_KEY=
LLM_PROVIDER=parallel
APP_URL=http://localhost:3000
# Docker Compose settings (not API credentials).
HOTNOW_PORT=3001
DOCKER_APP_URL=http://localhost:3001
# Optional. Seller research does not use these; company discovery uses Parallel.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Signing secret from Parallel Settings > Webhooks (not the API key).
# Used for FindAll discovery callbacks. Requires a public HTTPS APP_URL; localhost uses the background worker.
PARALLEL_WEBHOOK_SECRET=

# Lead delivery. See DELIVERY.md. Slack is optional; the app runs without it.
# Encrypts the Slack bot token at rest. openssl rand -base64 32
DELIVERY_TOKEN_KEY=
# Slack app bot scopes: chat:write, chat:write.public, channels:read, groups:read, channels:join
# Redirect: {APP_URL}/api/delivery/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Deferred, not read by this MVP: Google Sheets, Microsoft Teams, Telegram.

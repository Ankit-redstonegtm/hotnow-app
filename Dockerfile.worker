# syntax=docker/dockerfile:1
# Background worker only. The Next.js app itself stays on Vercel.
# Run exactly ONE replica. Provide the same runtime secrets as the app (see DEPLOY.md).
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN node scripts/build-worker.mjs

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder --chown=node:node /app/.next/background-worker.cjs ./background-worker.cjs
USER node
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "const fs=require('fs');process.exit(Date.now()-fs.statSync('/tmp/hotnow-worker-heartbeat').mtimeMs<90000?0:1)"
CMD ["node", "background-worker.cjs"]
